{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "OmniFolder Application Configuration File Schema",
  "description": "Schema that defines the format of the 'config.json' file that describes a specific OmniNetwork.",
  "type": "object",
  "required": ["network", "folders"],
  "properties": {
    "network": {
      "type": "object",
      "required": ["uuid", "name", "server"],
      "properties": {
        "uuid": {
          "type": "string",
          "pattern": "^omni-net-[0-9]$"
        },
        "name": {
          "type": "string"
        },
        "server": {
          "type": "object",
          "required": ["host", "port", "online"],
          "properties": {
            "host": {
              "type": "string",
              "format": "ipv4"
            },
            "port": {
              "type": "integer",
              "minimum": 1,
              "maximum": 65535
            },
            "online": {
              "type": "boolean"
            }
          }
        }
      }
    },
    "folders": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name", "lock_holder_id", "drives"],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^omni-folder-[0-9]{2}$"
          },
          "name": {
            "type": "string"
          },
          "lock_holder_id": {
            "type": ["string", "null"]
          },
          "drives": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["id", "name", "type", "curr_host", "port", "online", "capacity_bytes", "used_bytes", "local_path"],
              "properties": {
                "id": {
                  "type": "string",
                  "pattern": "^drive-[0-9]{2}$"
                },
                "name": {
                  "type": "string"
                },
                "type": {
                  "type": "string",
                  "enum": ["F", "P"]
                },
                "curr_host": {
                  "type": "string",
                  "format": "ipv4"
                },
                "port": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 65535
                },
                "online": {
                  "type": "boolean"
                },
                "capacity_bytes": {
                  "type": "integer"
                },
                "used_bytes": {
                  "type": "integer"
                },
                "local_path": {
                  "type": "string"
                },
                "mirror_dirs": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  },
                  "description": "For partial mirrors only: specific directories to mirror"
                }
              },
              "allOf": [
                {
                  "if": {
                    "properties": { "type": { "const": "P" } }
                  },
                  "then": {
                    "required": ["mirror_dirs"]
                  }
                }
              ]
            }
          }
        }
      }
    }
  }
}